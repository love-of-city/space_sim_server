# Generated by scripts/deploy_platform.ps1 -Start.
# No access log: URLs contain JWTs and the optional access key.
{
    admin off
    __GLOBAL_EXTRA__
}

__PUBLIC_URL__ {
    __TLS__
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Permissions-Policy "gamepad=(self)"
    }
    @signalling path /stream
    handle @signalling {
        reverse_proxy 127.0.0.1:__PLAYER_PORT__
    }
    handle {
        reverse_proxy 127.0.0.1:__API_PORT__
    }
}
