# Model meshes and CAD sources are stored in Git LFS (case-insensitive extensions).
model/**/*.[sS][tT][lL] filter=lfs diff=lfs merge=lfs -text
model/**/*.[oO][bB][jJ] filter=lfs diff=lfs merge=lfs -text
model/**/*.[sS][lL][dD][aA][sS][mM] filter=lfs diff=lfs merge=lfs -text
model/**/*.[sS][lL][dD][pP][rR][tT] filter=lfs diff=lfs merge=lfs -text
model/**/*.[sS][tT][pP] filter=lfs diff=lfs merge=lfs -text
model/**/*.[sS][tT][eE][pP] filter=lfs diff=lfs merge=lfs -text
model/**/*.[bB][rR][eE][pP] filter=lfs diff=lfs merge=lfs -text

# Preserve the upstream byte hash used by the offline reference runner.
tools/vendor/scenarioRendezVous.py text eol=lf
# Preserve delivered source bytes used by provenance SHA256 validation.
model/SARM_mjcf_20261012/** -text
model/SARM/platform/sarm_20261012.xml text eol=lf
