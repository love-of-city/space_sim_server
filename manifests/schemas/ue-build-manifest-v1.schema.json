{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ue-build-manifest-v1.schema.json",
  "type": "object",
  "required": [
    "schema",
    "build_id",
    "identity",
    "created_at"
  ],
  "properties": {
    "schema": {
      "const": "ue-build-manifest/1"
    },
    "build_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "$ref": "component-identity-v1.schema.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
